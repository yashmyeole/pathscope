# Copy to .env and fill in. Never commit .env.

# Qdrant Cloud (free tier) — from the cluster page in cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Collection name used everywhere (embedding dim is fixed by PLIP = 512)
QDRANT_COLLECTION=pathscope_plip_v1

# HuggingFace — only needed later for gated encoders (CONCH/UNI). Not needed for PLIP.
HF_TOKEN=

# Generation + judging (Phase 4/5). Free tiers, no card.
GROQ_API_KEY=
GEMINI_API_KEY=
