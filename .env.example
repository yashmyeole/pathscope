# Copy to .env and fill in. Never commit .env.

# Qdrant Cloud, from the cluster page in cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pathscope_plip_v1

# Optional, only raises the Hugging Face download rate limit
HF_TOKEN=

# Claim extraction (Groq) and checking / generation (Gemini)
GROQ_API_KEY=
GEMINI_API_KEY=
